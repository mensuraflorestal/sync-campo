<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="4dp"
    android:layout_marginEnd="4dp"
    android:layout_marginTop="5dp"
    android:layout_marginBottom="5dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="14dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp">

        <!-- Views mantidas ocultas para compatibilidade interna -->
        <View
            android:id="@+id/view_accent_strip"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/img_file_icon"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/img_file_cached_badge"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <!-- Linha 1: Categoria Editorial Discreta + Favorito + Opções -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/txt_file_category"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="APR • Segurança Operacional"
                android:textColor="#717A71"
                android:textSize="11.5sp"
                android:singleLine="true"
                android:ellipsize="end" />

            <ImageButton
                android:id="@+id/btn_file_favorite"
                android:layout_width="32dp"
                android:layout_height="28dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_star_border"
                android:contentDescription="Fixar documento" />

            <ImageButton
                android:id="@+id/btn_file_options"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_more_vert"
                app:tint="#717A71"
                android:contentDescription="Opções" />

        </LinearLayout>

        <!-- Linha 2: Título Principal Limpo (Estilo Editorial) -->
        <TextView
            android:id="@+id/txt_file_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="10dp"
            android:text="Derrubada de árvores com motosserra"
            android:textColor="#1B221B"
            android:textSize="14.5sp"
            android:textStyle="bold"
            android:lineSpacingExtra="2dp"
            android:ellipsize="end"
            android:maxLines="2" />

        <!-- Linha 3: Pílulas Suaves de Metadados + Seta -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/txt_file_details"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PDF • 396 KB"
                android:textColor="#2B3A2A"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_pill_offline"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:singleLine="true" />

            <TextView
                android:id="@+id/txt_file_offline_pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Offline"
                android:textColor="#2B3A2A"
                android:textSize="11sp"
                android:background="@drawable/bg_pill_offline"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:singleLine="true" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_chevron_right"
                android:contentDescription="Abrir" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
